.vs/

# Packaging output
artifacts/
*.zip
manifest.json

# IDE
.idea/
*.DotSettings.user

# Private working notes / roadmap / Claude operating manual — stays local, never pushed
private/
CLAUDE.md
# Security/bug audit log — kept local so open findings can be listed freely
audit.md

# Local staging bundle + backups (built artifacts, not source)
dist/

# Clean, licensed/source-attributed posters used only by the developer showcase harness.
# The generator accepts this directory explicitly and never reads Jellyfin data.
private/showcase-input/

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Local Playwright install for tools/Showcase/capture-settings.js
node_modules/

# AI workspace harness scaffolding — local-only, deliberately kept out of this public
# repository. These are workspace status/handoff documents and harness runtime state, not
# plugin source. They live on disk in the working copy and are covered by the workspace's
# dated Unraid backups. `scripts/verify.sh` is the one exception: it is a real project asset
# and is tracked.
/PROJECT.md
/AGENTS.md
/docs/ARCHITECTURE.md
/docs/DECISIONS.md
/docs/GOTCHAS.md
/docs/handoffs/
/.ai/
